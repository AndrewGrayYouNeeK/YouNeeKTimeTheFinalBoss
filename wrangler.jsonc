{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "youneektimethefinalboss",
  "compatibility_date": "2026-08-19",
  "preview_urls": true,
  "workers_dev": true,
  "routes": [
    { "pattern": "youneektime.com", "custom_domain": true },
    { "pattern": "www.youneektime.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
